generator client {
  provider = "prisma-client-js"
}

// datasource db {
//  provider = "sqlite"
//  url      = env("DATABASE_URL")
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  password   String
  passwordResetTokens PasswordResetToken[]
  role       String   @default("donatur") // admin, donatur
  phone      String?
  avatar     String?
  address    String?  // lokasi/alamat profil donatur
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  donations     Donation[]
  proposals     Proposal[]
  votes         Vote[]
  preferences   UserPreference[]
  notifications Notification[]
  campaigns     Campaign[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String   // Bencana, Ramadhan, Sosial, Donasi Rutin
  targetAmount    Int
  collectedAmount Int      @default(0)
  startDate       DateTime
  endDate         DateTime
  images    String?  // JSON array URL, contoh: '["url1","url2"]'
  paymentMethods  String?
  isPublic  Boolean  @default(true)
  location        String?  // lokasi campaign
  status          String   @default("active") // active, closed, completed
  isUrgent        Boolean  @default(false)
  uniqueCode      Int      @default(0) // Kode unik 3 digit untuk identifikasi transfer per campaign
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  dropOffLocation String?  // alamat tujuan pengiriman barang donasi

  donations  Donation[]
  fundUsages FundUsage[]
  creator    User        @relation(fields: [createdBy], references: [id])
  proposalId String?   @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id])
}

model Donation {
  id              String   @id @default(cuid())
  campaignId      String
  userId          String
  amount          Int
  donorName       String
  donorEmail      String
  donorPhone      String
  type            String   @default("uang")     // uang, barang
  paymentMethod   String   @default("transfer") // transfer, qris, tunai
  proofUrl        String?  // bukti pembayaran / bukti barang
  status          String   @default("pending")  // pending, approved, rejected
  message         String?  // keterangan/pesan dari donatur

  // Khusus donasi barang
  itemName        String?  // jenis barang
  itemQuantity    Int?     // jumlah barang
  senderAddress   String?  // alamat pengirim barang
  // dropOffLocation String?  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model FundUsage {
  id          String   @id @default(cuid())
  campaignId  String
  description String
  amount      Int
  date        DateTime @default(now())
  documentUrl String?
  createdBy   String
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning
  isRead    Boolean  @default(false)
  // ⬅ FIX: ditambahkan supaya klik notifikasi bisa langsung mengarahkan admin
  // ke detail item terkait (donasi/proposal), bukan cuma menandai "dibaca".
  // relatedType: 'donation' | 'proposal' | null — nentuin jenis entitas terkait
  // relatedId: ID dari entitas itu (Donation.id atau Proposal.id) — null kalau
  // notifikasi ini generik/tidak terkait ke item spesifik (misal notifikasi seed)
  relatedType String?
  relatedId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Proposal {
  id               String    @id @default(cuid())
  title            String
  description      String
  category         String    @default("Sosial")
  targetAmount     Int?
  proposedBy       String

  // Data pengaju
  proposerName     String?
  proposerEmail    String?   // email pengaju
  proposerPhone    String?   // no telp pengaju
  proposerAddress  String?   // alamat pengaju

  // Detail campaign yang diajukan
  campaignLocation String?   // alamat lokasi campaign
  startDate        DateTime? // tanggal dibuka campaign
  endDate          DateTime? // tanggal ditutup campaign

  // Dokumen pendukung
  officialDocUrl   String?   // surat resmi TTD kepala (wajib)
  photoUrls         String?   // foto keadaan (opsional)

  // Status & voting
  votesCount       Int       @default(0)
  status           String    @default("pending") // pending, approved, rejected
  rejectionReason  String?   // alasan ditolak (ditampilkan ke donatur)
  resubmittedFrom  String?   // id proposal sebelumnya jika pengajuan ulang

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposer User   @relation(fields: [proposedBy], references: [id])
  votes    Vote[]
  campaign Campaign?

  // Skor kelayakan proposal (masing-masing 0-100, rata-rata min 70 untuk lolos)
  kejelasanTujuan   Int @default(0) // Kejelasan tujuan dan dampak
  kelayakanAnggaran Int @default(0) // Kelayakan anggaran yang diajukan
  urgensi           Int @default(0) // Tingkat urgensi kebutuhan
  keterkaitanKampus Int @default(0) // Keterkaitan dengan kegiatan kampus
  kontribusiSosial  Int @default(0) // Kontribusi sosial bagi civitas
}

model Vote {
  id         String   @id @default(cuid())
  proposalId String
  userId     String
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([proposalId, userId])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}
